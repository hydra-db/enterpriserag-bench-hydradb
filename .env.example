# Copy to .env. Never commit .env.

# --- HydraDB (reproduction levels 3 and 4 only) ---
HYDRADB_API_KEY=
# Database and collection are set in the run config (config/*.yaml).
# HYDRADB_BASE_URL=https://api.hydradb.com

# --- Answer model and judge (levels 1 to 4) ---
# The published run used OpenRouter. A direct OpenAI key also works: set
# generation.provider / judge.provider to "openai" in the run config.
OPENROUTER_API_KEY=
# OPENAI_API_KEY=

# --- Benchmark checkout (created by `erb-hydradb setup`) ---
# ERB_REPO=./EnterpriseRAG-Bench
# ERB_DATA_DIR=./data
